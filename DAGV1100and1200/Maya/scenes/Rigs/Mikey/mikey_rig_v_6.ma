	setAttr ".b" -type "string" (
		"global proc ikfkSeamless(string $namespace,string $side,string $type){\n    string $optionsControl = $side + \"_\" + $type + \"_option_control\";\n    float $ikfk = `getAttr ($namespace+$optionsControl+\".ikfk\")`;\n    \n    if ($ikfk == 0) {// from FK to IK\n    string $ikControl = $namespace + $side + \"_\" + $type + \"_ik_control\";\n    string $ikPolevectorControl = $namespace + $side + \"_\" + $type + \"_ik_polevector_control\";\n    \n    string $ikControlSeamles = $namespace + $side + \"_\" + $type + \"_ik_control_ikfk_seamless\";\n    copyAttr -v -at r $ikControlSeamles $ikControl;\n    copyAttr -v -at t $ikControlSeamles $ikControl;\n    \n    string $ikPolevectorControlSeamles = $namespace + $side + \"_\" + $type + \"_ik_polevector_control_ikfk_seamless\";\n    float $ikPolevectorControlSeamles_t[] = `xform -q -ws -t $ikPolevectorControlSeamles`;   \n    xform -ws -t $ikPolevectorControlSeamles_t[0] $ikPolevectorControlSeamles_t[1] $ikPolevectorControlSeamles_t[2] $ikPolevectorControl;\n    \n    if ($type == \"leg\") {//for legs only\n        string $ikToesFootControl = $namespace +$side+\"_\"+$type+\"_ik_control\";\n"
		+ "            for ($attr in `listAttr -k $ikToesFootControl`)\n                setAttr ($ikToesFootControl+\".\"+$attr) 0;\n        string $ik5Control = $namespace + $side +\"_\"+$type+\"_ik_control\";\n        string $ik5ControlSeamles = $namespace + $side+ \"_foot_toe_seamless\";\n        $toe=`getAttr ($ik5ControlSeamles+\".rz\")`;\n        setAttr ($ik5Control+\".toes\") $toe;\n    }//for legs only    \n    setAttr ($namespace+$optionsControl+\".ikfk\") 1;\n    }//from FK to IK\n    else if ($ikfk == 1) {//from IK to FK\n        string $fk1Control = $namespace + $side + \"_\" + $type + \"_fk_1_control\";\n        string $fk1ControlSeamles = $namespace + $side + \"_\" + $type + \"_fk_1_control_ikfk_seamless\";    \n        copyAttr -v -at r $fk1ControlSeamles $fk1Control;\n\n        \n        string $fk2Control = $namespace + $side + \"_\" + $type + \"_fk_2_control\";\n        string $fk2ControlSeamles = $namespace + $side + \"_\" + $type + \"_fk_2_control_ikfk_seamless\";\n        if (`getAttr -se ($fk2Control+\".rx\")`) copyAttr -v -at rx $fk2ControlSeamles $fk2Control;\n"
		+ "        if (`getAttr -se ($fk2Control+\".ry\")`) copyAttr -v -at ry $fk2ControlSeamles $fk2Control;;\n        if (`getAttr -se ($fk2Control+\".rz\")`) copyAttr -v -at rz $fk2ControlSeamles $fk2Control;;\n            \n        string $fk3Control = $namespace + $side + \"_\" + $type + \"_fk_3_control\";\n        string $fk3ControlSeamles = $namespace + $side + \"_\" + $type + \"_fk_3_control_ikfk_seamless\";    \n        copyAttr -v -at r $fk3ControlSeamles $fk3Control;\n        \n        \n        if ($type == \"leg\") {//for legs only\n            string $fk4Control = $namespace + $side + \"_\" + $type + \"_fk_4_control\";\n            string $fk4ControlSeamles = $namespace + $side + \"_\" + $type + \"_fk_4_control_ikfk_seamless\";    \n            copyAttr -v -at r $fk4ControlSeamles $fk4Control;\n            \n            }//foor leg only\n    setAttr ($namespace+$optionsControl+\".ikfk\") 0;\n    }//from ik to FK\n    }//ikfk switch\nglobal proc mirror(string $namespace,string $from, string $to, string $center, float $offset[]){\n    string $oldSel[] =`ls -sl`;\n"
		+ "    string $baseTmp = `createNode transform -n ($namespace+\"baseTmp_tranform\")`;\n    string $ctrlTmp = `createNode transform -n ($namespace+\"ctrTmp_tranform\") -p $baseTmp`;\n    \n    parentConstraint $center $baseTmp;\n    delete `parentConstraint ($from) $ctrlTmp`;\n    setAttr ($baseTmp+\".sx\") -1;\n    string $ctrlDup[] = `duplicate -po -n ($namespace+$ctrlTmp+\"_duplicate\") $to`;\n    \n    if (`getAttr -se ($to+\".tx\")`){\n        pointConstraint $ctrlTmp $ctrlDup[0];\n        copyAttr -v -at t $ctrlDup[0] $to;\n        \n    }//if tx\n    if (`getAttr -se ($to+\".rx\")`){\n        delete `orientConstraint -offset $offset[0] $offset[1] $offset[2] $ctrlTmp $ctrlDup[0]`;\n        copyAttr -v -at r $ctrlDup[0] $to;\n    }//if rz  \n    if (`getAttr -se ($to+\".rz\")`){\n        delete `orientConstraint -skip x -skip y-offset $offset[0] $offset[1] $offset[2] $ctrlTmp $ctrlDup[0]`;\n        copyAttr -v -at rz $ctrlDup[0] $to;\n    }//if rx  \n    delete $baseTmp; \n    select -r $oldSel;\n}//mirror\nglobal proc mirrorControls(string $namespace, string $fromSide, string $type){\n"
		+ "    string $toSide = \"R\";\n    if($fromSide == \"R\") $toSide=\"L\";\n    \n    if ($type==\"arm\"){\n        copyAttrs($namespace,$fromSide+\"_\"+$type+\"_option_control\",$toSide+\"_\"+$type+\"_option_control\");\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_fk_1_control\",$namespace+$toSide+\"_\"+$type+\"_fk_1_control\",$namespace+\"M_spine_ik_3_control\",{0,0,0});\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_fk_2_control\",$namespace+$toSide+\"_\"+$type+\"_fk_2_control\",$namespace+\"M_spine_ik_3_control\",{0,0,0});\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_fk_3_control\",$namespace+$toSide+\"_\"+$type+\"_fk_3_control\",$namespace+\"M_spine_ik_3_control\",{0,0,0}); \n        copyAttrs($namespace,$fromSide+\"_\"+$type+\"_ik_polevector_control\",$toSide+\"_\"+$type+\"_ik_polevector_control\");\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_ik_control\",$namespace+$toSide+\"_\"+$type+\"_ik_control\",$namespace+\"M_spine_ik_3_control\",{180,0,0});\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_ik_polevector_control\",$namespace+$toSide+\"_\"+$type+\"_ik_polevector_control\",$namespace+\"M_spine_ik_3_control\",{0,0,0});       \n"
		+ "    }//mirror arm\n    else if ($type ==\"leg\"){\n        copyAttrs($namespace,$fromSide+\"_\"+$type+\"_option_control\",$toSide+\"_\"+$type+\"_option_control\");\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_fk_1_control\",$namespace+$toSide+\"_\"+$type+\"_fk_1_control\",$namespace+\"M_spine_ik_1_control\",{0,0,0});\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_fk_2_control\",$namespace+$toSide+\"_\"+$type+\"_fk_2_control\",$namespace+\"M_spine_ik_1_control\",{0,0,0});\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_fk_3_control\",$namespace+$toSide+\"_\"+$type+\"_fk_3_control\",$namespace+\"M_spine_ik_1_control\",{0,0,0}); \n        copyAttrs($namespace,$fromSide+\"_\"+$type+\"_ik_polevector_control\",$toSide+\"_\"+$type+\"_ik_polevector_control\");\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_ik_control\",$namespace+$toSide+\"_\"+$type+\"_ik_control\",$namespace+\"M_spine_ik_1_control\",{180,0,0});\n        mirror($namespace,$namespace+$fromSide+\"_\"+$type+\"_ik_polevector_control\",$namespace+$toSide+\"_\"+$type+\"_ik_polevector_control\",$namespace+\"M_spine_ik_1_control\",{0,0,0});        \n"
		+ "    }//mirror leg\n    else error(\"mirrorControls: $type must be 'arm' or 'leg'\");\n}//mirrorControls\n//---------------------------------------------------------------------------------------------------\nglobal proc copyAttrs(string $namespace, string $fromControl, string $toControl){\n    for ($attr in `listAttr -k -u ($namespace+$fromControl)`){\n        $val=`getAttr ($namespace+$fromControl+\".\" +$attr)`;\n        setAttr ($namespace+$toControl+\".\" +$attr) $val;\n    }//for\n}//copyattr\n//-----------------------------------------------------------------------------------------------\nglobal proc controlVis(string $control){\n\tif (`getAttr ($control+\".controlVis\")`==1){\n\t\tsetAttr ($control+\".controlVis\") 0;\n\t\t}else{\n\t\tsetAttr ($control+\".controlVis\") 1;\n\t\t}//if\n\t\t}//controlVis\n//-----------------------------------------------------------------------------------------------\nglobal proc selectAllControls(string $namespace){\n    select ($namespace+\"*_control\") ;\n\t}//selectControls\n//-----------------------------------------------------------------------------------------------\n"
		+ "global proc resetControls (string $namespace){\n    string $allControls[] = `ls ($namespace+\"*_control\")` ;\n    string $tmp1Ctrl[]=`duplicate -po -n \"tmp1control\" ($namespace+\"main_control\")`;\n    for ($ctrl in $allControls){\n        string $attrs[] = `listAttr -u -k  $ctrl`;\n        string $userAttrs[] = `listAttr -u -k -ud $ctrl`;\n        for ($attr in $attrs){\n            int $v = stringArrayContains($attr,$userAttrs);\n            if ($v==0){\n                setAttr ($ctrl+\".\"+$attr) 0;\n                if (`getAttr -l ($ctrl+\".sx\")`==0){\n                    setAttr ($ctrl+\".sx\") 1;\n                    }\n                if (`getAttr -l ($ctrl+\".sy\")`==0){\n                    setAttr ($ctrl+\".sy\") 1;\n                    }\n                if (`getAttr -l ($ctrl+\".sz\")`==0){\n                    setAttr ($ctrl+\".sz\") 1;\n                }//if scale\n                }else{\n                $dv=`addAttr -q -dv ($ctrl +\".\"+$attr)`;\n                setAttr($ctrl+\".\"+$attr) $dv;\n            }//else        \n\t\t}//forAttr\n    }\n"
		+ "    float $t[]=`getAttr ($tmp1Ctrl[0]+\".t\")`;\n\tfloat $r[]=`getAttr ($tmp1Ctrl[0]+\".r\")`;\n    setAttr (($namespace+\"main_control\")+\".t\") $t[0] $t[1] $t[2]; \n\tsetAttr (($namespace+\"main_control\")+\".r\") $r[0] $r[1] $r[2]; \t\t\n    delete $tmp1Ctrl[0];\n}//resetControl\n//-----------------------------------------------------------------------------------------------\nglobal proc dynamicParentSwitch(string $control, string $newParent){\n    if (!`objExists ($control+\".parent\")`) warning (\"`\"+$control+\"'has no parent\");\n    else{\n        string $oldSel[]=`ls -sl`;\n        string $tmp1Ctrl[]=`duplicate -po -n \"tmp1control\" $control`;\n        parent -w $tmp1Ctrl[0];\n        string $enum = `addAttr -q -en ($control+\".parent\")`;\n        string $buffer[];\n        tokenize $enum \":\" $buffer;\n        int $index=0;\n        \n        for (;$index<`size $buffer`; $index++)\n            if ($buffer[$index]==$newParent) break;\n        if ($index==`size $buffer`) warning (\"`\"+$control+\"`has no`\"+$newParent+\"`parent\");\n        else{\n            setAttr($control+\".parent\") $index;\n"
		+ "            \n            string $tmp2Ctrl[]=`duplicate -po -n \"tmp2control\" $control`;\n            if (`getAttr -se -l ($control+\".tx\")`==1){\n                orientConstraint $tmp1Ctrl[0] $tmp2Ctrl[0];\n\t\t\t\t} else if (`getAttr -se -l ($control+\".rx\")`==1){\n\t\t\t\tpointConstraint $tmp1Ctrl[0] $tmp2Ctrl[0];\n                }else{//else unlock\n                parentConstraint $tmp1Ctrl[0] $tmp2Ctrl[0];\n            }//else r lock\n            \n            if (`getAttr -se ($control+\".tx\")`){\n                float $t[]=`getAttr ($tmp2Ctrl[0]+\".t\")`;\n                setAttr ($control+\".t\") $t[0] $t[1] $t[2];\n            }//getAttr t\n            if (`getAttr -se -l ($control+\".rx\")`<1){\n            float $r[]=`getAttr ($tmp2Ctrl[0]+\".r\")`;\n            setAttr ($control+\".r\") $r[0] $r[1] $r[2];   \n            }//getAttr r \n            delete $tmp2Ctrl[0];                                 \n        }//else\n        delete $tmp1Ctrl[0]; \n        select -r $oldSel;\n    }//else\n}//dynamicParentSwitch\n//-----------------------------------------------------------------------------------------------\n"
		+ "if (`window -exists dkCreditsUI`)\n    deleteUI dkCreditsUI;\n    if (`windowPref -exists dkCreditsUI`)\n    windowPref -r dkCreditsUI;    \n    \n    window -title \"MIKEY RIG v4.0\"\n           -wh 300 60\n           -mxb off\n           -sizeable off\n           dkCreditsUI;\n           \n    showWindow dkCreditsUI;\n    \n    formLayout -bgc .2 .5 0 mainForm;\n   \n    text -l \"One love jah protection peace & unity\" -h 20 -bgc 1 .3 0 -font \"boldLabelFont\" rigByTxt;\n    text -l \"Let the animation help you in this)\" -h 20 -bgc .9 .8 0 -font \"boldLabelFont\" texByTxt;\n        \n    text -l \"\" ssTxt;\n    text -l \"rigging by Dubina Artem. Wish you comfortable work)\" vkTxt;\n      \n    formLayout -e \n               -af rigByTxt top 0\n               -af rigByTxt left 0\n               -af rigByTxt right 0\n               \n               -ac texByTxt top 5 ssTxt\n               -af texByTxt left 0\n               -af texByTxt right 0\n               \n               -ac vkTxt top 5 texByTxt\n               -af vkTxt left 0\n               -af vkTxt right 0         \n"
		+ "               \n               mainForm;\n               \nshowWindow dkCreditsUI;\n//----------------------------------------------------------------------------------------------------------");
